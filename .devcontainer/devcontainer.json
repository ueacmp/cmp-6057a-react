{
  "name": "React",
  "image": "mcr.microsoft.com/devcontainers/universal:linux",
  "onCreateCommand": "bash .devcontainer/configure-universal.sh",
  "updateContentCommand": "npm ci --prefer-offline --no-audit --no-fund",
  "waitFor": "updateContentCommand",
  "postAttachCommand": "HOST=0.0.0.0 PORT=3000 BROWSER=none npm run dev",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "React dev server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "codespaces": {
      "disableAutomaticConfiguration": true
    }
  }
}
